# API (packages/api/.env)
DATABASE_URL=postgres://localhost:5432/agent_registry
PORT=3001
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
# Optional in production: generated and stored in the database when unset
SESSION_SECRET=
REGISTRY_PRIVATE_KEY=
REGISTRY_PUBLIC_KEY=
# Enables /v1/admin routes
ADMIN_SECRET=
# Card top-ups (off unless STRIPE_ENABLED=1 and both keys are set)
STRIPE_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dispute and payout alerts: a Slack or Discord style webhook (optional)
ADMIN_ALERT_URL=
# Comma separated extra CORS origins; proxy hops to trust for client IPs (Railway: 1)
CORS_ORIGINS=
TRUST_PROXY_HOPS=

# Web (packages/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
