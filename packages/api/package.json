{
  "name": "@agent-registry/api",
  "version": "0.1.0",
  "description": "ANS API server: receipts and trust for agent work",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "ANS_DISABLE_JOBS=1 vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "rotate-key": "tsx scripts/rotate-key.ts",
    "cleanup-seeds": "tsx scripts/cleanup-seeds.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ans-core": "workspace:*",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.29.0",
    "hono": "^4.0.0",
    "postgres": "^3.4.0",
    "stripe": "^22.6.2",
    "undici": "^8.10.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "drizzle-kit": "^0.20.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0"
  }
}
